---
import Layout from "../layouts/Layout.astro";
import {
  ASKING_PRICE,
  DOMAIN,
  HERO_IMAGE,
  META,
  categories,
  guides,
  money,
  specs,
  steps,
  useCases,
} from "../data/site";

const product = {
  "@type": "Product",
  "@id": "https://flatfeehomesexchange.com/#domain",
  name: DOMAIN,
  description: META.description,
  category: "Domain name",
  image: HERO_IMAGE,
  brand: { "@type": "Brand", name: "Flat Fee Homes Exchange" },
  offers: {
    "@type": "Offer",
    availability: "https://schema.org/InStock",
    priceCurrency: "USD",
    url: "https://flatfeehomesexchange.com/contact/",
    seller: { "@id": "https://flatfeehomesexchange.com/#org" },
    ...(ASKING_PRICE != null ? { price: String(ASKING_PRICE) } : {}),
  },
};
---

<Layout title={META.title} description={META.description} schema={product}>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 lg:grid-cols-2 lg:py-16">
    <div>
      <p class="text-sm font-semibold tracking-wide text-brass uppercase">Premium .com for sale</p>
      <h1 class="mt-3 font-display text-3xl leading-tight sm:text-4xl lg:text-5xl">
        flat<wbr />fee<wbr />homes<wbr />exchange<wbr />.com
      </h1>
      <p class="mt-4 max-w-xl text-lg text-muted">
        A plain-language name for a flat-fee brokerage, a home-swap club, or an owner-listing marketplace.
        One owner. The registration only.
      </p>
      <div class="mt-8 rounded-card border border-line bg-card p-5">
        <p class="text-sm font-semibold text-muted">Asking price</p>
        <p class="mt-1 font-display text-4xl">{money(ASKING_PRICE)}</p>
        <p class="mt-2 text-sm text-muted">
          {
            ASKING_PRICE
              ? "Buy Now uses this figure. Offers are still read."
              : "Send the number you can close. No countdown, no fake viewers."
          }
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <button type="button" data-open-offer="Make Offer" data-track="hero_offer" class="inline-flex h-12 items-center justify-center rounded-full bg-sage px-6 font-semibold text-sage-ink">
            Make offer
          </button>
          <button type="button" data-open-offer="Buy Now" data-track="hero_buy" class="inline-flex h-12 items-center justify-center rounded-full border border-line bg-paper px-6 font-semibold">
            Buy now
          </button>
          <a href="/contact/" data-track="hero_contact" class="inline-flex h-12 items-center justify-center rounded-full px-4 font-semibold text-steel">
            Contact owner
          </a>
        </div>
      </div>
    </div>
    <figure class="overflow-hidden rounded-card border border-line bg-card">
      <div class="flex items-center gap-2 border-b border-line px-4 py-3">
        <span class="size-3 rounded-full bg-line"></span>
        <span class="size-3 rounded-full bg-line"></span>
        <span class="size-3 rounded-full bg-line"></span>
        <p class="min-w-0 truncate pl-2 text-sm text-muted">https://{DOMAIN}</p>
      </div>
      <img
        src={HERO_IMAGE}
        alt="Flat Fee Homes Exchange mark: an infinity loop joining a steel-blue house and a sage house, on wood"
        width="1280"
        height="720"
        decoding="async"
        fetchpriority="high"
        class="aspect-video w-full object-cover"
      />
      <figcaption class="px-4 py-3 text-sm text-muted">
        The brand mark. The sale is the domain, not this photograph.
      </figcaption>
    </figure>
  </section>

  <section class="border-y border-line bg-card" aria-label="Name specimen">
    <dl class="mx-auto grid max-w-6xl grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
      {
        specs.map((spec) => (
          <div class="px-4 py-5">
            <dt class="text-sm text-muted">{spec.label}</dt>
            <dd class="mt-1 font-display text-2xl">{spec.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14" aria-labelledby="fits-heading">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 id="fits-heading" class="font-display text-3xl">Who this name is for</h2>
        <p class="mt-2 max-w-xl text-muted">
          Filter by the business you would actually run. These are fits, not other domains for sale.
        </p>
      </div>
      <form id="fit-search-form" class="flex h-12 min-w-0 items-center gap-2 rounded-full border border-line bg-card px-4 sm:w-80" role="search">
        <label class="sr-only" for="fit-search">Search fits</label>
        <input id="fit-search" name="q" placeholder="Try brokerage, swap, investor" class="min-w-0 flex-1 bg-transparent text-base outline-none" />
      </form>
    </div>
    <div class="mt-6 flex flex-wrap gap-2" role="toolbar" aria-label="Filter by category">
      {
        categories.map((item) => (
          <button
            type="button"
            data-cat={item.id}
            aria-pressed={item.id === "all" ? "true" : "false"}
            class:list={[
              "inline-flex h-12 items-center rounded-full px-4 text-sm font-semibold",
              item.id === "all" ? "bg-sage text-sage-ink" : "border border-line bg-card",
            ]}
          >
            {item.label}
          </button>
        ))
      }
    </div>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        useCases.map((item) => (
          <li
            data-fit
            data-category={item.category}
            data-text={`${item.title} ${item.text} ${item.keywords.join(" ")}`}
            class="rounded-card border border-line bg-card p-5"
          >
            <p class="text-sm font-semibold text-brass capitalize">{item.category}</p>
            <h3 class="mt-2 font-display text-2xl leading-tight">{item.title}</h3>
            <p class="mt-2 text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
    <p id="fit-empty" hidden class="mt-6 text-muted" role="status">
      Nothing matches that filter. Clear the search or try another category.
    </p>
  </section>

  <section class="border-t border-line bg-card" aria-labelledby="transfer-heading">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 id="transfer-heading" class="font-display text-3xl">How a transfer works</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step) => (
            <li>
              <p class="font-display text-3xl text-brass">{step.n}</p>
              <h3 class="mt-2 text-lg font-semibold">{step.title}</h3>
              <p class="mt-2 text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
      <a href="/buy/" class="mt-8 inline-flex h-12 items-center font-semibold text-steel">Read the full buying notes</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14" aria-labelledby="trust-heading">
    <h2 id="trust-heading" class="font-display text-3xl">What you can verify</h2>
    <p class="mt-2 max-w-2xl text-muted">
      There are no invented testimonials on this site. These are the checks that matter.
    </p>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      <li class="rounded-card border border-line p-5">
        <h3 class="font-semibold">Escrow, not a wire</h3>
        <p class="mt-2 text-muted">Pay an independent escrow service. Funds move after you control the name.</p>
      </li>
      <li class="rounded-card border border-line p-5">
        <h3 class="font-semibold">Owner, not a broker desk</h3>
        <p class="mt-2 text-muted">The inquiry address on this site reaches the registrant.</p>
      </li>
      <li class="rounded-card border border-line p-5">
        <h3 class="font-semibold">Registration only</h3>
        <p class="mt-2 text-muted">You are not buying a brokerage, a license, or a promised audience.</p>
      </li>
    </ul>
  </section>

  <section class="border-t border-line" aria-labelledby="guides-heading">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 id="guides-heading" class="font-display text-3xl">Read before you offer</h2>
      <ul class="mt-6 divide-y divide-line border-y border-line">
        {
          guides.map((guide) => (
            <li>
              <a href={`/guides/${guide.slug}/`} class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:justify-between">
                <span class="font-display text-2xl">{guide.title}</span>
                <span class="text-sm text-muted">{guide.minutes} min</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
